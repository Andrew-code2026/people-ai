# Configuración del Servidor y Entorno
NODE_ENV=development
PORT=3000

# Base de Datos (MySQL / TiDB)
# Ejemplo local: mysql://usuario:contraseña@localhost:3306/people_ai
DATABASE_URL=mysql://root:root@localhost:3306/people_ai

# Secretos de Sesión y Autenticación
JWT_SECRET=super_secret_local_jwt_key_123456
VITE_APP_ID=people-ai-local
OWNER_OPEN_ID=local-admin-owner

# URLs de Autenticación OAuth (opcional en modo demo local)
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://portal.manus.im

# Configuración de Dominio / Procesos
REMINDER_COOLDOWN_HOURS=4
